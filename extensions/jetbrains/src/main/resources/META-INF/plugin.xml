<idea-plugin>
    <id>dev.jscx.intellij</id>
    <name>jscx</name>
    <vendor url="https://github.com/troglodyte/jscx">Michael Harris</vendor>

    <description><![CDATA[
        Cyclomatic complexity diagnostics for JavaScript, TypeScript, and JSX.
        <p>
        Functions scoring at or above the configured threshold are reported as
        warnings; at or above twice the threshold, as errors. Scoring follows the
        same rules as ESLint's <code>complexity</code> rule.
        </p>
        <p>
        Requires the <code>jscx</code> binary on your <code>PATH</code>
        (<code>cargo install --path .</code>), or an explicit path set under
        <b>Settings | Tools | jscx</b>.
        </p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- The LSP API is only present in paid JetBrains IDEs. This dependency is
         what keeps the plugin from being installable where it cannot work. -->
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.integrationProvider
                implementation="dev.jscx.intellij.JscxLspIntegrationProvider"/>

        <applicationConfigurable
                parentId="tools"
                id="dev.jscx.intellij.settings"
                displayName="jscx"
                instance="dev.jscx.intellij.JscxConfigurable"/>

        <notificationGroup id="jscx" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
